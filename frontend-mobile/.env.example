# Backend base URL. Use a LAN IP (not localhost) when running on a physical
# device so the device can reach the host's backend container. iOS simulator
# can hit `http://localhost:8000` directly; Android emulator should use
# `http://10.0.2.2:8000` (the emulator's host-machine alias) — see
# `frontend-mobile/README.md` for details.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Legacy alias from the original health-check flow. Kept for one release so
# existing local `.env` files don't break; new code reads
# `EXPO_PUBLIC_API_BASE_URL`. Drop after slice-5 (Epic #11) stabilises.
EXPO_PUBLIC_API_URL=http://localhost:8000

# ---- Per-provider gating flags ----
#
# These three flags mirror the web client's `VITE_GOOGLE_ENABLED` /
# `VITE_APPLE_ENABLED` / `VITE_FACEBOOK_ENABLED` (see
# `frontend-web/.env.example`) and the BE's `GOOGLE_ENABLED` /
# `APPLE_ENABLED` / `FACEBOOK_ENABLED`. Strict `=== "true"` parse: any
# other value, including unset, is `false`.
#
# Default mobile build today: Google + Facebook on. Apple stays off
# until App Store submission Epic #57 (see `docs/rfcs/0001-auth-sso.md`
# § "Deferred providers" for the rationale).

EXPO_PUBLIC_GOOGLE_ENABLED=true
EXPO_PUBLIC_FACEBOOK_ENABLED=true

# Apple-on-iOS is descoped from Epic #11. Stays `false` here until the
# App Store submission Epic re-enables it; flipping this alone won't
# light up a button — `expo-apple-authentication` would also have to be
# bundled per `docs/rfcs/0001-auth-sso.md` § "Deferred providers".
EXPO_PUBLIC_APPLE_ENABLED=false

# ---- Per-provider client IDs ----
#
# Google needs a separate OAuth client per platform (the iOS / Android /
# Web client IDs are distinct OAuth credentials in the Google Cloud
# Console). `expo-auth-session` picks the right one based on the
# runtime platform. See `frontend-mobile/README.md` § "Google sign-in
# setup" for the exact Cloud Console flow.

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# IDs → iOS application. The `bundleIdentifier` must match
# `app.json -> ios.bundleIdentifier` (`com.threadloop.app`).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# IDs → Android application. The package name must match
# `app.json -> android.package` (`com.threadloop.app`); the SHA-1
# fingerprint is the one Expo's dev client / EAS build uses (Expo Go's
# debug-fingerprint is documented in the Expo docs).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=

# Facebook App ID. Same Meta App as the backend's `FACEBOOK_APP_ID` —
# the `/debug_token` verifier checks `data.app_id` against that value.
# Create in developers.facebook.com → My Apps → Create App (Consumer
# use case → "Facebook Login for iOS / Android" products).
EXPO_PUBLIC_FACEBOOK_APP_ID=
